{
	"name": "hedgehog-x",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test:docker": "docker compose -f compose.test.yml up --build --abort-on-container-exit --exit-code-from playwright && docker compose -f compose.test.yml down -v",
		"test:docker:down": "docker compose -f compose.test.yml down -v",
		"test": "npm run test:e2e",
		"dev:all": "docker compose up --wait -d && pnpm dev",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"test:unit": "node --import tsx --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@better-auth/core": "1.6.33",
		"@better-auth/utils": "0.4.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.66.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"better-auth": "~1.6.33",
		"bits-ui": "^2.20.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"qrcode": "^1.5.4",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-cacheable-response": "^7.4.1",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-range-requests": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@uinstinct/svelte-wheel-picker": "^0.1.33",
		"better-auth-telegram": "^2.0.1",
		"blurhash": "^2.0.5",
		"dexie": "^4.4.6",
		"mode-watcher": "^1.1.0",
		"sharp": "^0.35.5"
	}
}
