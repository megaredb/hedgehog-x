# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# В продакшене с несколькими хостами лучше задать фиксированный публичный
# URL (например https://hedgehog.inc), иначе origin выводится из запроса.
# BETTER_AUTH_URL="https://hedgehog.inc"

# Telegram (OIDC)
# 1. Создайте бота у @BotFather → получите TELEGRAM_BOT_TOKEN.
# 2. В @BotFather (как Mini App): Bot Settings > Web Login → добавьте
#    URL сайта, затем откройте Web Login снова и пройдите OIDC-настройку.
#    Telegram выдаст отдельный Client ID и Client Secret (НЕ бот-токен!).
# 3. Allowed URL = origin сайта; Redirect URL =
#    https://<домен>/api/auth/callback/telegram-oidc — ОБА значения должны
#    быть зарегистрированы в BotFather, иначе Telegram вернёт
#    «redirect_uri required» на этапе авторизации.
#
# Локальный HTTPS-домен через mkcert (альтернатива ngrok):
#   mkcert "hedgehog-inc.localhost" "*.hedgehog-inc.localhost"
#   тогда в BotFather (Web Login > OIDC) укажите:
#     Allowed URL  = https://hedgehog-inc.localhost
#     Redirect URL = https://hedgehog-inc.localhost/api/auth/callback/telegram-oidc
#   (домен должен резолвиться на ваш прокси — Docker/трафик-прокси на :443,
#   который проксирует на локальный dev-сервер; у вас уже настроено).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""
